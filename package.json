{
  "name": "asmr-beauty-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade AI Skin Coach consumer mobile app and cloud backend",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:shared": "npm run test -w @asmr/shared",
    "test:backend": "npm run test -w @asmr/backend",
    "test:rules": "npm run test:rules -w @asmr/backend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
