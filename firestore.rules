rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // CORE SECURITY FUNCTIONS & HELPERS
    // =========================================================================
    
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isServerAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isDeletionGuarded(userId) {
      return exists(/databases/$(database)/documents/accountDeletionGuards/$(userId));
    }

    // This document is written only by the backend after a RevenueCat API check.
    // An expiry timestamp keeps Firestore access from outliving the purchase.
    function hasPaidAccess(userId) {
      let entitlement = /databases/$(database)/documents/users/$(userId)/entitlements/pro;
      return isOwner(userId)
        && request.auth.token.email_verified == true
        && exists(entitlement)
        && get(entitlement).data.isPro == true
        && get(entitlement).data.expiresAt is timestamp
        && get(entitlement).data.expiresAt > request.time;
    }
    
    // Keep profile creation and updates on the same server-owned field policy.
    function privilegedUserFields() {
      return [
        'isPro',
        'tier',
        'subscriptionTier',
        'entitlementStatus',
        'roles',
        'isAdmin',
        'remainingScans',
        'scanAllowanceMonthly',
        'credits',
        'affiliateCommission',
        'deletionStatus'
      ];
    }

    function doesNotModifyPrivilegedUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedUserFields());
    }
    
    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
    
    // =========================================================================
    // PUBLIC READ-ONLY CATALOG (ADMIN CONTROLLED WRITES ONLY)
    // =========================================================================
    
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isServerAdmin();
      
      match /offers/{offerId} {
        allow read: if isAuthenticated();
        allow write: if isServerAdmin();
      }
    }
    
    match /safetyPolicies/{policyVersion} {
      allow read: if isAuthenticated();
      allow write: if isServerAdmin();
    }
    
    // =========================================================================
    // SERVER-CONTROLLED ENTITLEMENTS & USAGE (READ ONLY BY OWNER)
    // =========================================================================
    
    match /entitlements/{userId} {
      allow read: if isOwner(userId) || isServerAdmin();
      allow write: if isServerAdmin(); // STRICT: Client can NEVER write entitlements
    }
    
    match /usage/{userId} {
      allow read: if isOwner(userId) || isServerAdmin();
      allow write: if isServerAdmin(); // STRICT: Client can NEVER reset quotas
    }
    
    // =========================================================================
    // USER DATA ISOLATION (request.auth.uid == userId)
    // =========================================================================
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isServerAdmin();
      
      // User can create their initial profile document
      allow create: if isOwner(userId)
                    && !isDeletionGuarded(userId)
                    && !request.resource.data.keys().hasAny(privilegedUserFields());
      
      // User can update profile, but CANNOT mutate server-owned privileged fields
      allow update: if isOwner(userId)
                    && !isDeletionGuarded(userId)
                    && doesNotModifyPrivilegedUserFields();
      // Account deletion must run through deleteUserAccount so nested documents,
      // storage objects, and the Auth record are removed together.
      allow delete: if false;
      
      // 1. Skin Scan Sessions (Client can initiate session, but server writes status changes & snapshots)
      match /skinScans/{scanId} {
        allow read: if hasPaidAccess(userId);
        allow create: if false;
        // Status transitions like QUEUED, COMPLETED, or setting resultSnapshotId are backend-only
        allow update: if isServerAdmin();
        allow delete: if hasPaidAccess(userId);
      }
      
      // 2. Skin Snapshots (READ-ONLY FOR CLIENT — WRITTEN ONLY BY TRUSTED WORKER)
      match /skinSnapshots/{snapshotId} {
        allow read: if hasPaidAccess(userId);
        allow write: if isServerAdmin();
      }
      
      // 3. User Routines
      match /routines/{routineId} {
        allow read, delete: if hasPaidAccess(userId);
        allow create, update: if hasPaidAccess(userId)
          && routineId == 'current'
          && request.resource.data.keys().hasOnly(['steps', 'updatedAt'])
          && request.resource.data.steps is list
          && request.resource.data.steps.size() > 0
          && request.resource.data.steps.size() <= 20
          && request.resource.data.updatedAt is int;
      }
      
      // 4. Daily Routine Logs (Check-ins, streaks)
      match /routineLogs/{logId} {
        allow read, delete: if hasPaidAccess(userId);
        allow create, update: if hasPaidAccess(userId)
          && logId.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.keys().hasOnly(['day', 'completedIds', 'updatedAt'])
          && request.resource.data.keys().hasAll(['day', 'completedIds', 'updatedAt'])
          && request.resource.data.day == logId
          && request.resource.data.completedIds is list
          && request.resource.data.completedIds.size() <= 20
          && request.resource.data.updatedAt is int;
      }
      
      // 5. My Shelf (Owned products)
      match /shelf/{shelfItemId} {
        allow read, delete: if hasPaidAccess(userId);
        allow create, update: if hasPaidAccess(userId)
          && shelfItemId.matches('^[A-Za-z0-9]{8,40}$')
          && request.resource.data.keys().hasOnly(['id', 'brand', 'name', 'category', 'openedOn', 'addedAt'])
          && request.resource.data.keys().hasAll(['id', 'brand', 'name', 'category', 'openedOn', 'addedAt'])
          && request.resource.data.id == shelfItemId
          && request.resource.data.brand is string
          && request.resource.data.brand.size() <= 80
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 100
          && request.resource.data.category in ['Cleanser', 'Moisturizer', 'Sunscreen', 'Treatment', 'Other']
          && (request.resource.data.openedOn == null ||
              (request.resource.data.openedOn is string && request.resource.data.openedOn.matches('^\\d{4}-\\d{2}-\\d{2}$')))
          && request.resource.data.addedAt is int;
      }
      
      // 6. AI Skin Coach Conversations
      match /conversations/{conversationId} {
        allow read: if hasPaidAccess(userId);
        allow write: if false;
        
        match /messages/{messageId} {
          allow read: if hasPaidAccess(userId);
          // User can send messages; coach replies are appended by backend function
          allow create: if false;
          allow update, delete: if false;
        }
      }
      
      // 7. Spot Journal (Visual appearance tracking)
      match /spotJournals/{journalId} {
        allow read: if hasPaidAccess(userId);
        allow write: if false;
        
        match /entries/{entryId} {
          allow read: if hasPaidAccess(userId);
          allow write: if false;
        }
      }
      
      // 8. Progress Entries
      match /progressEntries/{entryId} {
        allow read: if hasPaidAccess(userId);
        allow write: if false;
      }
      
      // 9. Recommendations Audit (Audit history for "Why this product?")
      match /recommendations/{recommendationId} {
        allow read: if hasPaidAccess(userId);
        allow write: if isServerAdmin();
      }
    }
  }
}
