rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // CORE SECURITY FUNCTIONS & HELPERS
    // =========================================================================
    
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isServerAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // Prevent client from setting or modifying privileged fields
    function doesNotModifyPrivilegedUserFields() {
      let forbiddenFields = [
        'isPro',
        'tier',
        'subscriptionTier',
        'entitlementStatus',
        'roles',
        'isAdmin',
        'remainingScans',
        'scanAllowanceMonthly',
        'credits',
        'affiliateCommission'
      ];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(forbiddenFields);
    }
    
    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
    
    // =========================================================================
    // PUBLIC READ-ONLY CATALOG (ADMIN CONTROLLED WRITES ONLY)
    // =========================================================================
    
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isServerAdmin();
      
      match /offers/{offerId} {
        allow read: if isAuthenticated();
        allow write: if isServerAdmin();
      }
    }
    
    match /safetyPolicies/{policyVersion} {
      allow read: if isAuthenticated();
      allow write: if isServerAdmin();
    }
    
    // =========================================================================
    // SERVER-CONTROLLED ENTITLEMENTS & USAGE (READ ONLY BY OWNER)
    // =========================================================================
    
    match /entitlements/{userId} {
      allow read: if isOwner(userId) || isServerAdmin();
      allow write: if isServerAdmin(); // STRICT: Client can NEVER write entitlements
    }
    
    match /usage/{userId} {
      allow read: if isOwner(userId) || isServerAdmin();
      allow write: if isServerAdmin(); // STRICT: Client can NEVER reset quotas
    }
    
    // =========================================================================
    // USER DATA ISOLATION (request.auth.uid == userId)
    // =========================================================================
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isServerAdmin();
      
      // User can create their initial profile document
      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny(['isPro', 'isAdmin', 'roles']);
      
      // User can update profile, but CANNOT mutate server-owned privileged fields
      allow update: if isOwner(userId) && doesNotModifyPrivilegedUserFields();
      allow delete: if isOwner(userId) || isServerAdmin(); // Right to Erasure
      
      // 1. Skin Scan Sessions (Client can initiate session, but server writes status changes & snapshots)
      match /skinScans/{scanId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                      && request.resource.data.status in ['CREATED', 'UPLOAD_PENDING']
                      && request.resource.data.userId == userId;
        // Status transitions like QUEUED, COMPLETED, or setting resultSnapshotId are backend-only
        allow update: if isServerAdmin();
        allow delete: if isOwner(userId);
      }
      
      // 2. Skin Snapshots (READ-ONLY FOR CLIENT — WRITTEN ONLY BY TRUSTED WORKER)
      match /skinSnapshots/{snapshotId} {
        allow read: if isOwner(userId);
        allow write: if isServerAdmin();
      }
      
      // 3. User Routines
      match /routines/{routineId} {
        allow read, write: if isOwner(userId);
      }
      
      // 4. Daily Routine Logs (Check-ins, streaks)
      match /routineLogs/{logId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
      
      // 5. My Shelf (Owned products)
      match /shelf/{shelfItemId} {
        allow read, write: if isOwner(userId);
      }
      
      // 6. AI Skin Coach Conversations
      match /conversations/{conversationId} {
        allow read, write: if isOwner(userId);
        
        match /messages/{messageId} {
          allow read: if isOwner(userId);
          // User can send messages; coach replies are appended by backend function
          allow create: if isOwner(userId) && request.resource.data.sender == 'user';
          allow update, delete: if isOwner(userId) || isServerAdmin();
        }
      }
      
      // 7. Spot Journal (Visual appearance tracking)
      match /spotJournals/{journalId} {
        allow read, write: if isOwner(userId);
        
        match /entries/{entryId} {
          allow read, write: if isOwner(userId);
        }
      }
      
      // 8. Progress Entries
      match /progressEntries/{entryId} {
        allow read: if isOwner(userId);
        allow write: if isServerAdmin() || isOwner(userId);
      }
      
      // 9. Recommendations Audit (Audit history for "Why this product?")
      match /recommendations/{recommendationId} {
        allow read: if isOwner(userId);
        allow write: if isServerAdmin();
      }
    }
  }
}
