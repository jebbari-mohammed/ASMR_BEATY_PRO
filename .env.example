# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (NAMES ONLY - NO SECRETS IN CODE REPOSITORY)
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_ENV=development # development | staging | production
GCLOUD_PROJECT=asmr-skin-coach
GOOGLE_CLOUD_LOCATION=us-central1
FIREBASE_STORAGE_BUCKET=asmr-skin-coach.appspot.com

# ------------------------------------------------------------------------------
# Google Gemini 3.8 Flash AI Skin Analysis & Coach (Server-side Only)
# Store in Google Cloud Secret Manager for Cloud Functions 2nd Gen
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_SKIN_MODEL=gemini-3.8-flash
GEMINI_COACH_MODEL=gemini-3.8-flash
GEMINI_MEDIA_RESOLUTION=HIGH
GEMINI_THINKING_LEVEL=MEDIUM

# ------------------------------------------------------------------------------
# Subscriptions & Entitlements (RevenueCat)
# ------------------------------------------------------------------------------
REVENUECAT_WEBHOOK_TOKEN=
REVENUECAT_SECRET_API_KEY=

# Mobile Client RevenueCat Public API Keys
EXPO_PUBLIC_RC_APPLE_API_KEY=appl_your_apple_api_key_here
EXPO_PUBLIC_RC_GOOGLE_API_KEY=goog_your_google_play_api_key_here

# ------------------------------------------------------------------------------
# Affiliate Networks & Merchant Partner Attribution (Server-side Only)
# ------------------------------------------------------------------------------
IHERB_AFFILIATE_ID=
YESSTYLE_AFFILIATE_ID=
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
SOVRN_COMMERCE_API_KEY=

# ------------------------------------------------------------------------------
# Firebase App Check (Server-side Attestation & Debug)
# ------------------------------------------------------------------------------
FIREBASE_APP_CHECK_DEBUG_TOKEN=
