rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photo features are not available in this release. Keep private storage
    // closed until consent, upload validation, retention, and erasure are tested.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Catalog art is uploaded through trusted server credentials only.
    match /catalog/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
