{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    },
    "testflight": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "credentialsSource": "local",
      "autoIncrement": false
    },
    "play-internal": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "credentialsSource": "remote",
      "autoIncrement": false
    }
  },
  "submit": {
    "production": {},
    "testflight": {
      "ios": {
        "ascAppId": "6809052897",
        "groups": ["Owner device QA"]
      }
    }
  }
}
