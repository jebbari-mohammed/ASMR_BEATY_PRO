{
  "expo": {
    "name": "ASMR Beauty Pro",
    "slug": "asmr-beauty-pro",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "buildNumber": "11",
      "supportsTablet": false,
      "bundleIdentifier": "com.asmr.beautypro",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A382B"
      },
      "package": "com.asmr.beautypro",
      "versionCode": 12,
      "allowBackup": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/app-check",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "backgroundColor": "#1A382B"
        }
      ],
      ["expo-build-properties", { "ios": { "useFrameworks": "static" } }],
      "./plugins/with-rnfb-static-framework",
      "./plugins/with-local-notifications-only",
      "expo-notifications"
    ],
    "scheme": "asmrskin",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ae81278a-7308-431e-a896-6c57e9cc212b"
      }
    },
    "owner": "mojebbari1"
  }
}
